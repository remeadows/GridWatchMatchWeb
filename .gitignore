/.wrangler/

# CodeRabbit local review artifacts — runtime state, never commit
.coderabbit/local/
.coderabbit/installer/
.coderabbit/skip-gate
.coderabbit/skip-log
.coderabbit/codex-prompt.md
# NOTE: .coderabbit/overrides.md is intentionally NOT ignored — it's the
# audit trail for review-override decisions and should be tracked in git.

# Local checksum baseline for copied iOS raster assets. Custom art belongs in
# public/assets/images/web-overrides/ and this manifest is regenerated by sync.
public/assets/images/.sync-manifest.json

# agent scratch (briefs/reports/review diffs)
/.superpowers/

# Dark-realism art (art/gridwatch-match): the concept references are private Drive files and stay
# out of git (references/v2/SOURCES.md says where they come from); draft renders are scratch.
/art/gridwatch-match/references/**/*.png
/art/gridwatch-match/previews/draft/
*.blend1
__pycache__/
