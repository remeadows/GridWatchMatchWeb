# @gridwatch/account-kit is a git-tag dependency; npm 12 refuses git deps unless allowed.
# root restricts git deps to those declared by the root package.json (verified: clean-dir npm ci succeeds).
# To bump the kit tag, re-resolve once with: npm install --allow-git=all   (one-off CLI flag; npm 12.0.2 on node 24.16.0 rejects the fresh re-resolution under root with EALLOWGIT ("Refusing to fetch … non-root packages of type git") even though the dep is declared here — reproduced 2026-09-12 with the lockfile on the previous tag; re-test after the next npm upgrade. CI keeps using npm ci under root.)
allow-git=root
