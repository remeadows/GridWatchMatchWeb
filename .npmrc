# @gridwatch/account-kit is a git-tag dependency; npm 12 refuses git deps unless allowed.
# root restricts git deps to those declared by the root package.json (verified: clean-dir npm ci succeeds).
# To bump the kit tag, re-resolve once with: npm install --allow-git=all   (one-off CLI flag; npm 12 rejects the fresh re-resolution under root with EALLOWGIT even though the dep is declared here — verified 2026-09-12. CI keeps using npm ci under root.)
allow-git=root
